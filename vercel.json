{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://personal-portfolio-p55w.vercel.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}